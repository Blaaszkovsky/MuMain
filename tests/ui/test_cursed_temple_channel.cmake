if(NOT DEFINED MU_MESSAGE_BOX_SOURCE)
    message(FATAL_ERROR "MU_MESSAGE_BOX_SOURCE is required")
endif()

file(READ "${MU_MESSAGE_BOX_SOURCE}" source)
string(REGEX MATCH "CCursedTempleProgressMsgBox::SetNpcIndex\\([^)]*\\)[\r\n ]*\\{[^}]*\\}" start "${source}")
if(NOT start MATCHES "m_dwNpcIndex = dwIndex;[\r\n ]*SocketClient->ToGameServer\\(\\)->SendTalkToNpcRequest\\(m_dwNpcIndex\\)")
    message(FATAL_ERROR "The relic channel must notify the server immediately after assigning its NPC")
endif()

string(FIND "${source}" "CCursedTempleProgressMsgBox::CompleteProcess(" completeBegin)
string(FIND "${source}" "bool mu::ui::window::CCursedTempleProgressMsgBox::Render()" completeEnd)
if(completeBegin LESS 0 OR completeEnd LESS completeBegin)
    message(FATAL_ERROR "The relic completion callback was not found")
endif()
math(EXPR completeLength "${completeEnd} - ${completeBegin}")
string(SUBSTRING "${source}" ${completeBegin} ${completeLength} complete)
if(NOT complete MATCHES "SendTalkToNpcRequest\\(pMsgBox->GetNpcIndex\\(\\)\\)")
    message(FATAL_ERROR "The relic completion callback must retain its idempotent NPC retry")
endif()
message(STATUS "Relic channel notifies the server at start and retries at completion")
