foreach(required MU_RECEIVER_SOURCE MU_UPDATE_SOURCE MU_WINDOW_SOURCE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${MU_RECEIVER_SOURCE}" receivers)
file(READ "${MU_UPDATE_SOURCE}" updates)
file(READ "${MU_WINDOW_SOURCE}" windows)

if(NOT receivers MATCHES "CursedTemplePacketSpan\\([^)]*\\)[\r\n ]*\\{[\r\n ]*if \\(!UI::CursedTemple::CanApplyNetworkUpdate\\(SceneFlag\\)")
    message(FATAL_ERROR "Every bounded IT receiver must reject off-world packets before mutation")
endif()
string(REGEX MATCHALL "CursedTemplePacketSpan\\(ReceiveBuffer, Size\\)" guardedPackets "${receivers}")
list(LENGTH guardedPackets packetCount)
if(NOT packetCount EQUAL 8)
    message(FATAL_ERROR "Expected all eight bounded IT receivers to use the guarded packet span")
endif()
foreach(entry OpenEntryOffer ShowMatchResult BeginReadyPhase)
    if(NOT updates MATCHES "void ${entry}\\([^)]*\\)[\r\n ]*\\{[\r\n ]*if \\(!CanApplyNetworkUpdate\\(SceneFlag\\)\\)[\r\n ]*return;")
        message(FATAL_ERROR "${entry} must reject off-world UI/sound state changes")
    endif()
endforeach()

# HideAll intentionally preserves this HUD, so result handling can copy its team.
string(FIND "${windows}" "bool CSystem::IsImpossibleHideInterface" policyBegin)
string(SUBSTRING "${windows}" ${policyBegin} -1 policy)
if(NOT policy MATCHES "dwKey == INTERFACE_CURSEDTEMPLE_GAMESYSTEM")
    message(FATAL_ERROR "The match HUD must survive HideAll until its result copies the team")
endif()
if(NOT updates MATCHES "SetMyTeam\\(g_pCursedTempleWindow->GetMyTeam\\(\\)\\);[\r\n ]*UI::Windows::Hide\\(mu::ui::window::INTERFACE_CURSEDTEMPLE_GAMESYSTEM\\)")
    message(FATAL_ERROR "The result must copy its local team before hiding the match HUD")
endif()
message(STATUS "IT receiver/facade scene boundary and result team ordering are preserved")
