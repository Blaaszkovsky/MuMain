/* Keep the entry HUD centered at its original 220/480 viewport-height anchor.
   Shared ornaments retain their proportions; the open middle grows for wrapped names.
   The private MapName_I2 atlas is prepared offline from the reference OZD. */
@spritesheet map-name-decoration
{
    src: "../../assets/MapName_I2.tga";
    map-name-top: 0px 0px 204px 38px;
    map-name-bottom: 0px 80px 204px 36px;
}

body { pointer-events: none; }
#banner { top: 45.8333%; width: 264dp; max-width: 90%; pointer-events: none; }
#ornament_top { width: 100%; height: 49.1765dp; decorator: image(map-name-top); }
#ornament_bottom { width: 100%; height: 46.5882dp; decorator: image(map-name-bottom); }
#name {
    margin: 0 4%; min-height: 54.3529dp;
    display: flex; align-items: center; justify-content: center;
    font-family: token(font-title); font-size: 24dp; line-height: 1.1;
    color: #fffc00; font-effect: shadow(1dp 1dp #000000);
    text-align: center;
}
#name_text { max-width: 100%; word-break: break-all; }
#strife { position: absolute; top: -28dp; width: 166dp; height: 28dp; }
